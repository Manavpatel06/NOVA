#!/usr/bin/env bash
# nova-hub -- everyday commands for NOVA's hub (docs/decisions/0019).
#
#   nova-hub login     sign in to Tailscale + Claude, publish the hub, check everything  (run once)
#   nova-hub status    checklist: is every part of the hub working?
#   nova-hub test      ask the local model ten sample sentences and time it
#   nova-hub update    pull the latest NOVA from GitHub and restart
#   nova-hub logs      the hub service's recent log
#   nova-hub backup    snapshot NOVA's memory now (also runs every night at 03:30)
#   nova-hub bark KEY  save your Bark key (iPhone alerts), then send a test alert
#   nova-hub ping      send a test alert to your iPhone
#   nova-hub github    sign the hub in to GitHub, so approved upgrades reach your laptop
#   nova-hub upgrades  NOVA's self-upgrades: what's building, ready, installed
#   nova-hub share     turn on the shared drive \\nova-hub\nova (your devices only, over Tailscale)
#   nova-hub voice     give NOVA on the hub ears and a voice (one-time download, ~900 MB)
#   nova-hub talk      where to talk to NOVA from your phone
#   nova-hub ears on|off   the hub's own mic + speaker: say "Nova, ..." in the room
#   nova-hub phone     give NOVA a real phone number (Plivo or Twilio): call it, or it calls you
#   nova-hub apikey    use your monthly Claude API credit first (faster), Max plan after
#   nova-hub face on|off   NOVA's live face as this laptop's desktop background, screen kept awake
#   nova-hub connect   your apps for NOVA: google (Gmail drafts + Calendar) | canvas | signin EMAIL | add | list
#   nova-hub voice-reboot on|off   let "Nova, reboot the hub" (+ "Nova, confirm") restart this computer
#   nova-hub tune [off]  quicker replies: Wi-Fi power saving off, CPU performance profile (asks first)
#   nova-hub hearing fast|accurate   speech-to-text: base.en (~2.5x quicker) or small.en (fewer mistakes)
#   nova-hub wifi      how good the hub's Wi-Fi is (signal, band, speed, power saving)
set -uo pipefail

NOVA_DIR="${NOVA_DIR:-$HOME/NOVA}"
DATA_DIR="$NOVA_DIR/data"
PORT=8765
MODEL="qwen3.5:2b"
PY="$NOVA_DIR/.venv/bin/python"

say()  { printf '\n\033[1;36m== %s\033[0m\n' "$*"; }
good() { printf '   \033[32m[ok]\033[0m %s\n' "$*"; }
bad()  { printf '   \033[31m[!!]\033[0m %s\n' "$*"; FAILED=$((FAILED+1)); }
note() { printf '   \033[33m[--]\033[0m %s\n' "$*"; }
FAILED=0

ts_json()  { tailscale status --json 2>/dev/null; }
ts_name()  { ts_json | jq -r '.Self.DNSName // empty' | sed 's/\.$//'; }
ts_owner() { ts_json | jq -r '(.Self.UserID|tostring) as $u | .User[$u].LoginName // empty'; }
health()   { curl -fsS --max-time 5 "http://127.0.0.1:$PORT/v1/health" 2>/dev/null; }

cmd_status() {
  FAILED=0
  say "NOVA hub status"
  [[ "$(systemctl is-enabled sleep.target 2>/dev/null)" == "masked" ]] && good "never sleeps" || bad "sleep isn't off -- run setup_hub.sh again"
  sudo -n true 2>/dev/null && { sudo ufw status | grep -q "Status: active" && good "firewall on (Tailscale only)" || bad "firewall is off -- run setup_hub.sh again"; }
  if [[ "$(ts_json | jq -r '.BackendState // empty')" == "Running" ]]; then
    good "Tailscale online as $(ts_name)"
  else
    bad "Tailscale not signed in -- run: nova-hub login"
  fi
  tailscale serve status 2>/dev/null | grep -q "127.0.0.1:$PORT" && good "hub published on https://$(ts_name)" || bad "hub not published -- run: nova-hub login"
  systemctl is-active --quiet ollama && good "Ollama running" || bad "Ollama not running: sudo systemctl restart ollama"
  ollama list 2>/dev/null | grep -q "^$MODEL" && good "local model $MODEL installed" || bad "model missing: ollama pull $MODEL"
  systemctl --user is-active --quiet nova-hub && good "nova-hub service running" || bad "nova-hub service down -- nova-hub logs"
  local h; h="$(health)"
  if [[ -n "$h" ]]; then
    [[ "$(jq -r .ok <<<"$h")" == "true" ]] && good "hub healthy (model loaded: $(jq -r .model_loaded <<<"$h"), memory files mirrored: $(jq -r .memory_files <<<"$h"))" \
      || bad "hub unhealthy: $h"
    [[ "$(jq -r .owner_set <<<"$h")" == "true" ]] && good "owner: $(cat "$DATA_DIR/hub_owner" 2>/dev/null)" || bad "no owner set -- run: nova-hub login"
  else
    bad "hub not answering on 127.0.0.1:$PORT -- nova-hub logs"
  fi
  [[ -s "$HOME/.claude/.credentials.json" ]] && good "Claude Code signed in" || bad "Claude Code not signed in -- run: nova-hub login"
  if [[ -x "$HOME/NOVA-forge/.venv/bin/python" ]] && bwrap --ro-bind / / --unshare-all --dev /dev --proc /proc true 2>/dev/null; then
    good "upgrade workshop ready (sandboxed tests)"
  else
    note "upgrade workshop not ready: run setup_hub.sh again"
  fi
  gh auth status >/dev/null 2>&1 && good "GitHub connected (upgrades reach your laptop)" || note "GitHub not connected: nova-hub github"
  local h; h=$(health)
  if [[ "$(jq -r '.assistant' <<<"$h" 2>/dev/null)" == "true" ]]; then
    [[ "$(jq -r '.voice_ready' <<<"$h")" == "true" ]] && good "NOVA lives here: talk at https://$(ts_name)/" \
      || note "NOVA lives here, text only for now -- voice: nova-hub voice"
  fi
  [[ "$(jq -r '.devices.laptop.online // false' <<<"$h" 2>/dev/null)" == "true" ]] \
    && good "your laptop is connected (NOVA Link)" || note "laptop not connected (NOVA Link runs on it when it's on)"
  [[ "$(jq -r '.phone' <<<"$h" 2>/dev/null)" == "true" ]] && good "phone calls set up (Twilio)"
  if [[ "$(jq -r '.api.key_set // false' <<<"$h" 2>/dev/null)" == "true" ]]; then
    good "Claude API credit: \$$(jq -r '.api.usd' <<<"$h") of \$$(jq -r '.api.budget_usd' <<<"$h") used this month (then the Max plan)"
  else
    note "thinking with the Max plan (optional, faster: nova-hub apikey)"
  fi
  systemctl is-active --quiet smbd && good "shared drive on (\\\\nova-hub\\nova, Tailscale only)" || note "shared drive off (optional): nova-hub share"
  [[ -s "$DATA_DIR/bark_key" ]] && good "iPhone alerts set up (Bark)" || note "iPhone alerts not set up yet (optional): install Bark, then  nova-hub bark <your key>"
  systemctl --user is-active --quiet nova-backup.timer && good "nightly memory backup on" || bad "backup timer off: systemctl --user enable --now nova-backup.timer"
  [[ "$(loginctl show-user "$USER" -p Linger --value 2>/dev/null)" == "yes" ]] && good "keeps running with nobody logged in" || bad "linger off: sudo loginctl enable-linger $USER"
  echo
  if (( FAILED == 0 )); then
    printf '\033[1;32mAll good. The hub is up.\033[0m\n'
    local name; name="$(ts_name)"
    [[ -n "$name" ]] && printf '\nOn your main laptop, NOVA needs this hub name (Claude can set it for you):\n    hub.host: "%s"\n\n' "$name"
  else
    printf '\033[1;31m%d thing(s) to fix above.\033[0m\n' "$FAILED"
  fi
  return $(( FAILED > 0 ))
}

cmd_login() {
  say "1/5  Tailscale"
  if [[ "$(ts_json | jq -r '.BackendState // empty')" != "Running" ]]; then
    echo "   A sign-in link appears below: open it, sign in with the same account as your laptop and phone."
    sudo tailscale up --ssh --operator="$USER" || { echo "Tailscale sign-in didn't finish; run nova-hub login again."; return 1; }
  fi
  sudo tailscale set --operator="$USER" --ssh >/dev/null 2>&1 || true
  local owner; owner="$(ts_owner)"
  [[ -n "$owner" ]] || { echo "Couldn't read your Tailscale account; run nova-hub login again."; return 1; }
  mkdir -p "$DATA_DIR"
  printf '%s\n' "$owner" > "$DATA_DIR/hub_owner"
  chmod 600 "$DATA_DIR/hub_owner"
  good "signed in as $owner (only this account can use the hub)"

  say "2/5  Publishing the hub to your devices (HTTPS, Tailscale only)"
  while [[ "$(ts_json | jq -r '(.CertDomains // []) | length')" == "0" ]]; do
    echo "   Tailscale needs HTTPS turned on for your account (one click):"
    echo "     https://login.tailscale.com/admin/dns  ->  make sure MagicDNS is on, then 'Enable HTTPS'"
    read -rp "   Press Enter once that's done (Ctrl+C to stop)... " _
  done
  # output stays visible: if Tailscale still wants something, it says so here
  timeout 60 sudo tailscale serve --bg "$PORT" || { echo "Publishing didn't finish; run nova-hub login again."; return 1; }
  ts_name > "$DATA_DIR/hub_name"
  good "https://$(ts_name)"
  echo "   Also: login.tailscale.com/admin/machines -> nova-hub -> ... -> Disable key expiry"

  say "3/5  Claude (your Max plan)"
  if [[ ! -s "$HOME/.claude/.credentials.json" ]]; then
    echo "   Claude opens next: choose 'Claude account with subscription', sign in with your Max account,"
    echo "   then type /exit to come back here."
    read -rp "   Press Enter to start... " _
    claude || true
  fi
  [[ -s "$HOME/.claude/.credentials.json" ]] && good "Claude Code signed in" || bad "Claude sign-in not found; run nova-hub login again later"

  say "4/5  GitHub (so upgrades you approve reach your laptop)"
  cmd_github || bad "GitHub sign-in didn't finish; run nova-hub github later"

  say "5/5  Starting the hub"
  systemctl --user restart nova-hub
  sleep 3
  cmd_status
  local ok=$?
  echo
  read -rp "Restart now so everything starts the way it will every day? [Y/n] " ans
  [[ "${ans:-Y}" =~ ^[Yy] ]] && sudo reboot
  return $ok
}

cmd_test() {
  "$PY" -m nova.hub selftest
}

cmd_update() {
  say "Updating NOVA"
  git -C "$NOVA_DIR" pull --ff-only || { echo "Couldn't update (local changes?)."; return 1; }
  "$PY" -m pip install -q --no-deps -e "$NOVA_DIR"
  install -m 755 "$NOVA_DIR/hub/nova-hub" "$HOME/.local/bin/nova-hub"
  cp "$NOVA_DIR"/hub/systemd/nova-*.{service,timer} "$HOME/.config/systemd/user/" && systemctl --user daemon-reload
  ollama pull "$MODEL" >/dev/null
  systemctl --user restart nova-hub
  good "updated to $(git -C "$NOVA_DIR" log -1 --format='%h %s')"
}

cmd_bark() {
  local key="${1:-}"
  if [[ ! "$key" =~ ^[A-Za-z0-9]{10,64}$ ]]; then
    echo "Usage: nova-hub bark <key>"
    echo "  In the Bark app on your iPhone, the key is the part after https://api.day.app/ in the example URLs."
    return 1
  fi
  mkdir -p "$DATA_DIR"
  ( umask 077; printf '%s\n' "$key" > "$DATA_DIR/bark_key" )
  chmod 600 "$DATA_DIR/bark_key"
  good "Bark key saved"
  cmd_ping
}

cmd_ping() {
  "$PY" -m nova.hub ping
}

cmd_github() {
  command -v gh >/dev/null || { echo "gh isn't installed: run setup_hub.sh again"; return 1; }
  if ! gh auth status >/dev/null 2>&1; then
    echo "   A code and a link appear below: open the link on any device, enter the code, approve."
    gh auth login --hostname github.com --git-protocol https --web || return 1
  fi
  gh auth setup-git >/dev/null 2>&1
  git -C "$NOVA_DIR" ls-remote --exit-code origin HEAD >/dev/null 2>&1 && good "GitHub connected" || { bad "can't reach your NOVA repo on GitHub"; return 1; }
}

cmd_upgrades() {
  local owner; owner="$(cat "$DATA_DIR/hub_owner" 2>/dev/null)"
  curl -fsS --max-time 10 -H "Tailscale-User-Login: $owner" -H "Content-Type: application/json" \
    -d '{}' "http://127.0.0.1:$PORT/v1/forge/list" \
    | jq -r '.jobs[]? | "\(.status)\t\(.request)\t\(.detail)"' 2>/dev/null \
    || echo "No upgrades (or the hub isn't running: nova-hub logs)"
}

cmd_share() {
  # A network drive for your laptop (ADR 0022): ~/Shared on this hub, reachable
  # ONLY over Tailscale, SMB3 with encryption required, your account only, no
  # guests. Samba can't bind to tailscale0 (it skips non-broadcast interfaces),
  # so it listens normally and four layers keep it Tailscale-only: the firewall
  # (UFW, tailscale0 only), systemd's per-service interface and address
  # filters, and Samba's own hosts allow.
  local share="$HOME/Shared"
  say "Shared drive: \\\\nova-hub\\nova  ->  $share"
  sudo apt-get -y -qq install samba >/dev/null || { bad "couldn't install Samba"; return 1; }
  mkdir -p "$share/backups"
  chmod 750 "$share"
  [[ -f /etc/samba/smb.conf.before-nova ]] || sudo cp /etc/samba/smb.conf /etc/samba/smb.conf.before-nova
  sudo tee /etc/samba/smb.conf >/dev/null <<CONF
# NOVA hub (nova-hub share): one private share, reachable only over Tailscale.
[global]
   server string = nova-hub
   bind interfaces only = no
   hosts allow = 127.0.0.1 100.64.0.0/10 fd7a:115c:a1e0::/48
   hosts deny = 0.0.0.0/0 ::/0
   server min protocol = SMB3
   server smb encrypt = required
   map to guest = never
   restrict anonymous = 2
   disable netbios = yes
   smb ports = 445
   load printers = no
   printing = bsd
   printcap name = /dev/null
   disable spoolss = yes
   log file = /var/log/samba/log.%m
   max log size = 1000

[nova]
   path = $share
   valid users = $USER
   read only = no
   browseable = yes
   create mask = 0640
   directory mask = 0750
CONF
  sudo testparm -s >/dev/null 2>&1 || { bad "Samba config check failed"; return 1; }
  # The kernel only lets smbd talk over loopback and tailscale0, and only to
  # loopback and Tailscale addresses. It starts after Tailscale and restarts
  # with it (the interface filter is fixed when smbd starts).
  sudo mkdir -p /etc/systemd/system/smbd.service.d
  sudo tee /etc/systemd/system/smbd.service.d/90-nova.conf >/dev/null <<'CONF'
[Unit]
After=tailscaled.service
Wants=tailscaled.service
PartOf=tailscaled.service
[Service]
ExecStartPre=/bin/sh -c 'for i in $(seq 1 30); do ip link show tailscale0 >/dev/null 2>&1 && exit 0; sleep 2; done; exit 0'
RestrictNetworkInterfaces=lo tailscale0
IPAddressDeny=any
IPAddressAllow=localhost 100.64.0.0/10 fd7a:115c:a1e0::/48
CONF
  sudo systemctl disable --now nmbd >/dev/null 2>&1 || true
  sudo systemctl daemon-reload
  sudo systemctl enable smbd >/dev/null 2>&1
  sudo systemctl restart smbd
  if ! sudo pdbedit -L 2>/dev/null | grep -q "^$USER:"; then
    echo "   Choose a password for the shared drive (your laptop asks for it once, then remembers it):"
    sudo smbpasswd -a "$USER" || { bad "password not set; run nova-hub share again"; return 1; }
  fi
  # refuse to leave it running unless every layer is really in place
  local why=""
  sudo ufw status 2>/dev/null | grep -q "Status: active" || why="the firewall is off"
  [[ "$(systemctl show smbd -p RestrictNetworkInterfaces --value)" == *tailscale0* ]] || why="the interface filter isn't active"
  [[ -n "$(systemctl show smbd -p IPAddressDeny --value)" ]] || why="the address filter isn't active"
  systemctl is-active --quiet smbd || why="Samba didn't start"
  if [[ -n "$why" ]]; then
    bad "shared drive NOT turned on: $why"; sudo systemctl stop smbd; return 1
  fi
  good "shared drive on: \\\\$(ts_name | cut -d. -f1)\\nova  (user: $USER)"
  echo "   On your laptop:  powershell -ExecutionPolicy Bypass -File D:\\NOVA\\scripts\\hub_drive.ps1 -User $USER"
}

KOKORO_URL="https://github.com/thewh1teagle/kokoro-onnx/releases/download/model-files-v1.0"
KOKORO_FILES="7d5df8ecf7d4b1878015a32686053fd0eebe2bc377234608764cc0ef3636a6c5  kokoro-v1.0.onnx
bca610b8308e8d99f32e6fe4197e7ec01679264efed0cac9140fe9c29f1fbf7d  voices-v1.0.bin"
# Silero VAD v5.1.2 (the speech detector the hub's own mic uses)
VAD_URL="https://raw.githubusercontent.com/snakers4/silero-vad/v5.1.2/src/silero_vad/data/silero_vad.onnx"
VAD_SUM="2623a2953f6ff3d2c1e61740c6cdb7168133479b267dfef114a4a3cc5bdd788f"

cmd_voice() {
  # NOVA's ears (Whisper) and voice (Kokoro) on the hub (ADR 0023). Downloads
  # happen here, once -- NOVA itself never downloads anything.
  say "NOVA's ears and voice on the hub (one-time download, about 900 MB)"
  local models="$NOVA_DIR/models" stt
  "$NOVA_DIR/.venv/bin/pip" install -q numpy "faster-whisper==1.2.1" onnxruntime "espeakng-loader>=0.2.4" \
    "phonemizer-fork>=3.3.2" || { bad "couldn't install the speech libraries"; return 1; }
  # kokoro-onnx 0.5.0 is plain Python but declares Python <3.14, and the hub
  # has 3.14; its dependencies are installed above, and it was checked to
  # speak (and be heard back word for word) on 3.14
  "$NOVA_DIR/.venv/bin/pip" install -q --no-deps --ignore-requires-python "kokoro-onnx==0.5.0" \
    || { bad "couldn't install the Kokoro voice library"; return 1; }
  good "speech libraries installed"
  mkdir -p "$models/tts" "$models/hf"
  while read -r sum file; do
    if ! echo "$sum  $models/tts/$file" | sha256sum -c --status >/dev/null 2>&1; then
      curl -fsSL --retry 3 -o "$models/tts/$file.part" "$KOKORO_URL/$file" || { bad "couldn't download $file"; return 1; }
      echo "$sum  $models/tts/$file.part" | sha256sum -c --status || { rm -f "$models/tts/$file.part"; bad "$file didn't match its checksum"; return 1; }
      mv "$models/tts/$file.part" "$models/tts/$file"
    fi
  done <<< "$KOKORO_FILES"
  good "voice files (checked against known checksums)"
  mkdir -p "$models/vad"
  if ! echo "$VAD_SUM  $models/vad/silero_vad.onnx" | sha256sum -c --status >/dev/null 2>&1; then
    curl -fsSL --retry 3 -o "$models/vad/silero_vad.onnx.part" "$VAD_URL" || { bad "couldn't download the speech detector"; return 1; }
    echo "$VAD_SUM  $models/vad/silero_vad.onnx.part" | sha256sum -c --status \
      || { rm -f "$models/vad/silero_vad.onnx.part"; bad "the speech detector didn't match its checksum"; return 1; }
    mv "$models/vad/silero_vad.onnx.part" "$models/vad/silero_vad.onnx"
  fi
  good "speech detector (for the hub's own mic)"
  stt=$("$PY" -c 'from nova.config import load_config; print(load_config().hub.stt_model)')
  [[ "$stt" =~ ^[a-z0-9][a-z0-9.-]{1,39}$ ]] || { bad "odd stt_model in config: $stt"; return 1; }
  "$PY" -I -c "from faster_whisper import download_model; download_model('$stt', cache_dir='$models/hf')" >/dev/null 2>&1 \
    || { bad "couldn't download the Whisper $stt model"; return 1; }
  good "Whisper $stt (speech to text)"
  systemctl --user restart nova-hub.service
  sleep 8
  health | jq -e '.voice_ready' >/dev/null 2>&1 && good "NOVA on the hub can hear and speak" \
    || note "restarting; check in a minute with: nova-hub status"
  cmd_talk
}

cmd_wifi() {
  # How good the hub's Wi-Fi link is (ADR 0033): signal, band, speed, power saving
  local dev
  for dev in $(iw dev 2>/dev/null | awk '/Interface/ {print $2}'); do
    say "Wi-Fi ($dev)"
    iw dev "$dev" link | awk '/SSID|freq|signal|tx bitrate|rx bitrate/ {$1=$1; print "   " $0}'
    echo "   $(iw dev "$dev" get power_save 2>/dev/null)"
    local sig; sig=$(iw dev "$dev" link | awk '/signal/ {print $2}')
    if [[ -n "$sig" && "$sig" -lt -67 ]]; then
      bad "weak signal ($sig dBm): move the hub closer to the router, or use a USB Ethernet adapter"
    elif [[ -n "$sig" ]]; then
      good "signal $sig dBm is fine"
    fi
    iw dev "$dev" link | grep -q 'freq: 24' && note "on 2.4 GHz: if your router has 5 GHz, that band is usually quicker"
  done
}

cmd_hearing() {
  # ADR 0033: how the hub turns speech into text. accurate = Whisper small.en (the default);
  # fast = Whisper base.en, about 2.5x quicker on a CPU but makes more mistakes.
  local models="$NOVA_DIR/models" pick answer
  case "${1:-}" in
    fast) pick="base.en" ;;
    accurate) pick="small.en" ;;
    *) echo "usage: nova-hub hearing fast|accurate   (now: $(cat "$DATA_DIR/stt_model" 2>/dev/null || echo small.en))"; return 1 ;;
  esac
  if ! compgen -G "$models/hf/models--*faster-whisper-$pick*" >/dev/null; then
    read -rp "   Download the Whisper $pick model (about $([[ $pick == base.en ]] && echo 145 || echo 480) MB)? (y/n) " answer
    [[ "$answer" =~ ^[Yy] ]] || { note "nothing changed"; return 0; }
    "$PY" -I -c "from faster_whisper import download_model; download_model('$pick', cache_dir='$models/hf')" >/dev/null 2>&1 \
      || { bad "couldn't download the Whisper $pick model"; return 1; }
  fi
  mkdir -p "$DATA_DIR"; printf '%s\n' "$pick" > "$DATA_DIR/stt_model"
  systemctl --user restart nova-hub.service
  good "hearing: Whisper $pick"
}

cmd_talk() {
  local name; name=$(ts_name)
  say "Talk to NOVA from your phone"
  if [[ -z "$name" ]]; then bad "Tailscale isn't up (run: nova-hub login)"; return 1; fi
  echo "   1. Install Tailscale on your iPhone and sign in with the same account."
  echo "   2. Open in Safari:   https://$name/"
  echo "   3. Share button -> Add to Home Screen, so NOVA opens like an app."
}

cmd_ears() {
  case "${1:-}" in
    on)
      [[ -f "$NOVA_DIR/models/vad/silero_vad.onnx" ]] || { bad "run 'nova-hub voice' first"; return 1; }
      sudo apt-get -y -qq install libportaudio2 >/dev/null 2>&1 || true
      "$NOVA_DIR/.venv/bin/pip" install -q sounddevice || { bad "couldn't install sounddevice"; return 1; }
      touch "$DATA_DIR/hub_ears"
      systemctl --user restart nova-hub.service
      good "the hub listens for \"Nova, ...\" on its own mic and answers on its speaker"
      note "it hears the room only while you're signed in on the hub (that's when its sound system runs)"
      ;;
    off)
      rm -f "$DATA_DIR/hub_ears"
      systemctl --user restart nova-hub.service
      good "the hub's own mic is off"
      ;;
    *) echo "usage: nova-hub ears on|off" ;;
  esac
}

cmd_phone() {
  # ADR 0025. Manav types every value here himself; they go to data/phone.json
  # (0600) through a pipe, never on a command line.
  say "A real phone number for NOVA"
  local provider answer
  read -rp "   Which carrier: 1) Plivo (cheaper: ~\$0.50/month + ~half a cent a minute, \$10 free credit)  2) Twilio  [1/2] " answer
  if [[ "$answer" == "2" ]]; then provider=twilio; else provider=plivo; fi
  if [[ "$provider" == "plivo" ]]; then
    cat <<'HOW'
   First, on plivo.com:
     1. Sign up (the trial gives free credit, no card), and verify your own phone number when it asks.
     2. Buy (rent) a phone number with Voice: Phone Numbers -> Buy Number.
     3. Copy your Auth ID (starts with MA) and Auth Token from the console's home page.
   And in Tailscale's admin console (login.tailscale.com -> Access controls), allow Funnel
   for this hub -- Tailscale shows a link to do it if the last step below asks.

HOW
  else
    cat <<'HOW'
   First, on twilio.com (about $1.15 a month for the number, plus a cent or two a minute):
     1. Create an account, add a little credit, and buy a phone number that has Voice.
     2. Verify your own phone number in Twilio (Phone Numbers -> Verified Caller IDs).
     3. Copy your Account SID and Auth Token from the Twilio console's home page.
   And in Tailscale's admin console (login.tailscale.com -> Access controls), allow Funnel
   for this hub -- Tailscale shows a link to do it if the last step below asks.

HOW
  fi
  local sid token nova mine pin name
  if [[ "$provider" == "plivo" ]]; then read -rp "   Auth ID (starts with MA): " sid
  else read -rp "   Account SID (starts with AC): " sid; fi
  read -rsp "   Auth Token (typing is hidden): " token; echo
  read -rp "   NOVA's new number, like +14805551234: " nova
  read -rp "   Your own phone number, like +14805550000: " mine
  read -rsp "   Choose a 6-digit PIN for calls (hidden): " pin; echo
  printf '{"provider":"%s","account_sid":"%s","auth_token":"%s","nova_number":"%s","owner_number":"%s","pin":"%s"}' \
    "$provider" "$sid" "$token" "$nova" "$mine" "$pin" | "$PY" -m nova.hub phone-setup || return 1
  unset token pin
  timeout 60 sudo tailscale funnel --bg --https=8443 --set-path=/phone "http://127.0.0.1:$PORT/v1/phone" \
    || { bad "Funnel didn't start -- allow Funnel for this hub in Tailscale's admin console, then run this again"; return 1; }
  local code
  code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 15 -X POST \
         -H 'Content-Type: application/x-www-form-urlencoded' --data 'CallSid=test' "https://$(ts_name):8443/phone/voice")
  if [[ "$code" == "403" ]]; then
    good "the phone door is open: only https://$(ts_name):8443/phone, and it turned away an unsigned test call"
  else
    bad "the phone route answered $code instead of 403 -- tell Claude this number"
  fi
  systemctl --user restart nova-hub.service
  name=$(ts_name)
  echo
  if [[ "$provider" == "plivo" ]]; then
    echo "   Last step, in Plivo: Voice -> Applications -> Add New Application:"
    echo "     Answer URL  ->  https://$name:8443/phone/voice   (POST)"
    echo "     Hangup URL  ->  https://$name:8443/phone/status  (POST)"
    echo "   Save it, then Phone Numbers -> your NOVA number -> Application Type: XML Application -> pick it."
  else
    echo "   Last step, in Twilio: Phone Numbers -> your NOVA number -> Voice configuration:"
    echo "     A call comes in  ->  Webhook  ->  https://$name:8443/phone/voice   (HTTP POST)"
  fi
  echo "   Then call your NOVA number from your phone, type your PIN, and talk."
  echo "   NOVA can call you too: \"Nova, call me\" or \"Nova, call me at 7 to wake me up\"."
}

cmd_apikey() {
  # ADR 0026. Manav pastes the key himself; it goes through a pipe into
  # data/anthropic_key (0600), never onto a command line or into a log.
  say "Claude API credit for NOVA's thinking"
  echo "   Create a key at console.anthropic.com -> API Keys (it starts with sk-ant-)."
  echo "   NOVA uses it until about \$90 of the month is spent, then the Max plan until the 1st."
  local key
  read -rsp "   Paste the key (typing is hidden): " key; echo
  printf '%s' "$key" | "$PY" -m nova.hub apikey-setup || { unset key; bad "key not saved"; return 1; }
  unset key
  systemctl --user restart nova-hub.service
  good "NOVA on the hub now thinks with your API credit first"
}

FACE_AUTOSTART="$HOME/.config/autostart/nova-face.desktop"

FACE_EXT_UUID="nova-face@nova"
FACE_EXT_DIR="$HOME/.local/share/gnome-shell/extensions/$FACE_EXT_UUID"

face_deps() {
  # GTK 4 + WebKitGTK for the face app (system Python, not NOVA's venv)
  /usr/bin/python3 -c 'import gi; gi.require_version("Gtk","4.0"); gi.require_version("WebKit","6.0")' 2>/dev/null && return 0
  local answer
  read -rp "   The face app needs GTK 4 + WebKitGTK from Ubuntu (python3-gi gir1.2-gtk-4.0 gir1.2-webkit-6.0, ~60 MB). Install? (y/n) " answer
  [[ "$answer" =~ ^[Yy] ]] || return 1
  sudo apt-get install -y python3-gi gir1.2-gtk-4.0 gir1.2-webkit-6.0 >/dev/null
}

face_extension_on() {
  mkdir -p "$FACE_EXT_DIR"
  cp "$NOVA_DIR/hub/face/$FACE_EXT_UUID/"* "$FACE_EXT_DIR/"
  gsettings set org.gnome.shell disable-user-extensions false 2>/dev/null
  if gnome-extensions enable "$FACE_EXT_UUID" 2>/dev/null; then
    return 0
  fi
  # GNOME Shell on Wayland only sees a new extension after you sign in again;
  # list it now so it switches on by itself at that sign-in.
  local cur; cur=$(gsettings get org.gnome.shell enabled-extensions 2>/dev/null)
  if [[ "$cur" != *"$FACE_EXT_UUID"* ]]; then
    if [[ "$cur" == "@as []" || -z "$cur" ]]; then cur="['$FACE_EXT_UUID']"; else cur="${cur%]}, '$FACE_EXT_UUID']"; fi
    gsettings set org.gnome.shell enabled-extensions "$cur"
  fi
  return 2
}

face_extension_off() {
  gnome-extensions disable "$FACE_EXT_UUID" 2>/dev/null
  local cur; cur=$(gsettings get org.gnome.shell enabled-extensions 2>/dev/null)
  if [[ "$cur" == *"$FACE_EXT_UUID"* ]]; then
    cur=$(sed -e "s/, '$FACE_EXT_UUID'//; s/'$FACE_EXT_UUID', //; s/'$FACE_EXT_UUID'//" <<<"$cur")
    gsettings set org.gnome.shell enabled-extensions "$cur"
  fi
  rm -rf "$FACE_EXT_DIR"
}

cmd_face() {
  # ADR 0028: NOVA's face is the hub's desktop -- a live wallpaper behind every
  # window, so the terminal and apps open on top of it. Screen kept awake (lid open).
  local launch="/usr/bin/python3 $NOVA_DIR/hub/face/renderer.py"
  case "${1:-}" in
    on)
      say "NOVA's face as this screen's background"
      if [[ -z "${WAYLAND_DISPLAY:-}${DISPLAY:-}" ]]; then
        bad "run this in a terminal on the hub's own desktop (not over SSH)"; return 1
      fi
      face_deps || { bad "the face app needs GTK 4 + WebKitGTK"; return 1; }
      good "face app ready"
      face_extension_on; local ext=$?
      if [[ $ext -eq 0 ]]; then good "background add-on on"; else note "background add-on installed -- it switches on after you sign out and back in once"; fi
      pkill -f "nova-face" 2>/dev/null || true             # the old Firefox kiosk, if it was running
      rm -rf "$HOME/.nova-face" "$HOME/snap/firefox/common/nova-face" 2>/dev/null
      mkdir -p "$(dirname "$FACE_AUTOSTART")"
      cat > "$FACE_AUTOSTART" <<DESK
[Desktop Entry]
Type=Application
Name=NOVA face
Comment=NOVA live as this screen's background
Exec=sh -c "sleep 5; exec $launch"
StartupWMClass=io.nova.face
X-GNOME-Autostart-enabled=true
DESK
      good "starts by itself whenever you sign in"
      gsettings set org.gnome.desktop.session idle-delay 0 2>/dev/null
      gsettings set org.gnome.settings-daemon.plugins.power idle-dim false 2>/dev/null
      gsettings set org.gnome.settings-daemon.plugins.power sleep-inactive-ac-type 'nothing' 2>/dev/null
      gsettings set org.gnome.settings-daemon.plugins.power sleep-inactive-battery-type 'nothing' 2>/dev/null
      good "screen stays on (no blanking, dimming or sleep)"
      local answer
      read -rp "   After a restart, sign in automatically so NOVA's face comes back by itself? Anyone who opens the hub then sees your desktop. (y/n) " answer
      if [[ "$answer" =~ ^[Yy] ]]; then
        local conf=/etc/gdm3/custom.conf
        sudo cp -n "$conf" "$conf.before-nova" 2>/dev/null
        sudo sed -i -e '/^\s*#\?\s*AutomaticLoginEnable\s*=/d' -e '/^\s*#\?\s*AutomaticLogin\s*=/d' "$conf"
        sudo sed -i "/^\[daemon\]/a AutomaticLoginEnable=true\nAutomaticLogin=$USER" "$conf"
        good "signs in automatically after a restart"
      else
        note "after a restart, sign in once and the face starts"
      fi
      pkill -f "hub/face/renderer.py" 2>/dev/null || true
      nohup $launch >/dev/null 2>&1 &
      if [[ $ext -eq 0 ]]; then
        good "NOVA's face is your background -- open Terminal or any app on top of it"
      else
        note "until you sign out and in once, the face shows full-screen as a normal window (Super key to get past it)"
      fi
      ;;
    off)
      rm -f "$FACE_AUTOSTART"
      pkill -f "hub/face/renderer.py" 2>/dev/null || true
      pkill -f "nova-face" 2>/dev/null || true
      face_extension_off
      gsettings set org.gnome.desktop.session idle-delay 300 2>/dev/null
      gsettings set org.gnome.settings-daemon.plugins.power idle-dim true 2>/dev/null
      if grep -q '^AutomaticLoginEnable=true' /etc/gdm3/custom.conf 2>/dev/null; then
        sudo sed -i -e '/^AutomaticLoginEnable=true/d' -e "/^AutomaticLogin=$USER/d" /etc/gdm3/custom.conf
      fi
      good "face off; your normal wallpaper is back and the screen sleeps normally again"
      ;;
    *) echo "usage: nova-hub face on|off" ;;
  esac
}

cmd_connect() {
  # ADR 0030: connected apps -- Gmail + Calendar (all your Google accounts), Canvas, any MCP server
  if [[ ! -x "$NOVA_DIR/.venv/bin/uvx" ]]; then
    local answer
    read -rp "   Connected apps run with uv (from PyPI, ~40 MB, into NOVA's own folder). Install it? (y/n) " answer
    [[ "$answer" =~ ^[Yy] ]] || { note "nothing changed"; return 1; }
    "$PY" -m pip install -q uv || { bad "couldn't install uv"; return 1; }
    good "uv installed"
  fi
  command -v bwrap >/dev/null 2>&1 || { bad "connected apps run sandboxed: sudo apt install bubblewrap"; return 1; }
  # signing in needs the sign-in page's return port (localhost:8000) free: pause NOVA meanwhile
  [[ "${1:-}" == "signin" ]] && systemctl --user stop nova-hub
  (cd "$NOVA_DIR" && "$PY" -m nova.hub.connectors "$@") || { [[ "${1:-}" == "signin" ]] && systemctl --user start nova-hub; return 1; }
  case "${1:-list}" in
    google|canvas|add|remove|on|off|signin)
      systemctl --user restart nova-hub
      good "NOVA restarted with your apps (first start downloads each one: give it a minute)"
      ;;
  esac
}

cmd_voice_reboot() {
  # lets NOVA restart this computer when you say "Nova, reboot the hub" (and "Nova, confirm"):
  # one sudoers line allowing exactly `systemctl reboot` without a password, for you only
  local rule="/etc/sudoers.d/nova-reboot"
  case "${1:-}" in
    on)
      local answer
      read -rp "   Let NOVA restart this hub by voice (it still asks for \"Nova, confirm\")? This adds $rule. (y/n) " answer
      [[ "$answer" =~ ^[Yy] ]] || { note "nothing changed"; return 0; }
      printf '%s ALL=(root) NOPASSWD: /usr/bin/systemctl reboot\n' "$USER" | sudo tee "$rule.tmp" >/dev/null
      sudo chmod 440 "$rule.tmp"
      if sudo visudo -cf "$rule.tmp" >/dev/null; then sudo mv "$rule.tmp" "$rule"; good "NOVA can restart the hub by voice"
      else sudo rm -f "$rule.tmp"; bad "the rule didn't check out; nothing changed"; return 1; fi
      ;;
    off) sudo rm -f "$rule"; good "NOVA can no longer restart the hub" ;;
    *) echo "usage: nova-hub voice-reboot on|off" ;;
  esac
}

cmd_tune() {
  # 2026-11-26 "voice is delayed": the hub answered pings on the home network in 110+ ms (Wi-Fi power
  # saving) and ran its CPU in a power-saving profile. Both are reversible: nova-hub tune off.
  local conf=/etc/NetworkManager/conf.d/90-nova-wifi-powersave.conf
  case "${1:-on}" in
    on)
      say "Making the hub quicker to answer"
      local answer
      read -rp "   Turn off Wi-Fi power saving on the hub (faster replies, slightly more power)? (y/n) " answer
      if [[ "$answer" =~ ^[Yy] ]]; then
        printf '[connection]\nwifi.powersave = 2\n' | sudo tee "$conf" >/dev/null
        sudo systemctl reload NetworkManager 2>/dev/null || sudo systemctl restart NetworkManager
        for dev in $(iw dev 2>/dev/null | awk '/Interface/ {print $2}'); do sudo iw dev "$dev" set power_save off 2>/dev/null; done
        good "Wi-Fi power saving off"
      fi
      if command -v powerprofilesctl >/dev/null 2>&1; then
        read -rp "   Run the CPU in its performance profile while plugged in (faster voice, a bit warmer)? (y/n) " answer
        if [[ "$answer" =~ ^[Yy] ]]; then
          powerprofilesctl set performance && good "CPU: performance profile"
        fi
      fi
      note "check it from the laptop: .venv\\Scripts\\python.exe scripts\\probe_voice_latency.py"
      ;;
    off)
      sudo rm -f "$conf"; sudo systemctl reload NetworkManager 2>/dev/null
      command -v powerprofilesctl >/dev/null 2>&1 && powerprofilesctl set balanced
      good "back to Ubuntu's defaults"
      ;;
    *) echo "usage: nova-hub tune [on|off]" ;;
  esac
}

cmd_logs() {
  journalctl --user -u nova-hub -n "${1:-60}" --no-pager
}

cmd_backup() {
  local src="$DATA_DIR/memory-mirror" dest="$DATA_DIR/backups"
  [[ -d "$src" ]] || { echo "Nothing to back up yet (the laptop hasn't sent NOVA's memory)."; return 0; }
  mkdir -p "$dest"
  local file="$dest/memory-$(date +%Y-%m-%d).tar.gz"
  tar -czf "$file.tmp" -C "$DATA_DIR" memory-mirror && mv "$file.tmp" "$file"
  ls -1t "$dest"/memory-*.tar.gz 2>/dev/null | tail -n +31 | xargs -r rm --   # keep 30 days
  good "backed up to $file"
}

case "${1:-status}" in
  login)  cmd_login ;;
  status) cmd_status ;;
  test)   cmd_test ;;
  update) cmd_update ;;
  logs)   shift; cmd_logs "$@" ;;
  backup) cmd_backup ;;
  bark)   shift; cmd_bark "$@" ;;
  ping)   cmd_ping ;;
  github) cmd_github ;;
  upgrades) cmd_upgrades ;;
  share)  cmd_share ;;
  voice)  cmd_voice ;;
  talk)   cmd_talk ;;
  ears)   shift; cmd_ears "$@" ;;
  phone)  cmd_phone ;;
  apikey) cmd_apikey ;;
  face)   shift; cmd_face "$@" ;;
  connect) shift; cmd_connect "$@" ;;
  voice-reboot) shift; cmd_voice_reboot "$@" ;;
  tune)   shift; cmd_tune "$@" ;;
  hearing) shift; cmd_hearing "$@" ;;
  wifi)   cmd_wifi ;;
  *) sed -n '2,26p' "$0"; exit 1 ;;
esac
