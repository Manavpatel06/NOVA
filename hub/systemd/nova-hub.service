[Unit]
Description=NOVA hub (brain, local model lane, reminders, upgrades, memory mirror)

[Service]
WorkingDirectory=%h/NOVA
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/NOVA/.venv/bin/python -m nova.hub serve
Restart=always
RestartSec=5
# its own memory budget (the brain's claude process and upgrade builds
# included), leaving room for Ollama's model
MemoryHigh=2500M
MemoryMax=3500M

[Install]
WantedBy=default.target
